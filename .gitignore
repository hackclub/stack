# Dependencies
node_modules/

# Build outputs
client/dist/
dist/
build/

# Environment and secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Caches and coverage
.cache/
.vite/
coverage/
