{
  "name": "stack",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "dev:full": "concurrently -n client,server -c blue,green \"npm run dev --workspace=client\" \"npm run dev --workspace=server\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "build": "npm run build --workspace=client",
    "start": "NODE_ENV=production node server/index.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "airtable": "^0.12.2",
    "canvas-confetti": "^1.9.4"
  }
}
